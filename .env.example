# ──────────────────────────────────────────────────────────────────────────────
# Environment variables — copy to .env and fill real values.
# NEVER commit a .env with real secrets.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database (Supabase) ───────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project → Settings → Database → Connection String
#
# Option A: Direct connection (port 5432) — use for Alembic migrations
DATABASE_URL_SYNC=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
#
# Option B: Connection Pooler / Transaction mode (port 6543) — use for app (Vercel serverless)
# asyncpg driver automatically disables prepared statements when port 6543 is detected.
DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ── Redis (optional) ──────────────────────────────────────────────────────────
# Leave unset on Vercel free tier — idempotency falls back to a no-op.
# Uncomment and set if you add Upstash Redis (free tier available):
# REDIS_URL=rediss://default:[password]@[host].upstash.io:6379

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGEME_at_least_32_chars_long
JWT_REFRESH_SECRET=CHANGEME_refresh_at_least_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Frontend / Vercel (Public) ────────────────────────────────────────────────
# Set these in your Vercel Dashboard → Frontend project → Settings → Environment Variables
VITE_API_BASE_URL=https://your-backend.vercel.app
VITE_WS_BASE_URL=wss://your-backend.vercel.app

# ── App (Backend) ─────────────────────────────────────────────────────────────
APP_ENV=production
# Comma-separated list of allowed origins for CORS.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend.vercel.app

# ── Analytics constants (document — do not change without changelog entry) ────
MEAL_WEIGHT_KG=0.5
MEALS_PER_BENEFICIARY_PER_PERIOD=14

# ── Routing (Person 5) — all optional; defaults work offline ──────────────────
# Provider: heuristic | osrm | tomtom
ROUTING_PROVIDER=heuristic
ROUTING_OSRM_BASE_URL=https://router.project-osrm.org
# Required for tomtom; never commit a real key.
ROUTING_TOMTOM_API_KEY=
ROUTING_TOMTOM_BASE_URL=https://api.tomtom.com
ROUTING_TIMEOUT_SECONDS=4
# Assumption: road km per straight-line km.
ROUTING_CIRCUITY_FACTOR=1.3
# Traffic model: time_of_day | city_average | free_flow
ROUTING_TRAFFIC_MODEL=time_of_day
ROUTING_CACHE_TTL_SECONDS=120
